// builtins:
//
// - shell (invoke anything in a shell)
//   Environment is baked from `exports` in reverse dependency chain
//
// type annotations:
//
//  (var) - substitute for variable
//  (string) - string type (default)
//  (list) - list of strings
//  (argument) - value of an argument

// namespace support.
// uses same approach as rust with `::` qualifiers
phase crosstools {
    variables {
      target "x86_64-linux-gnu"
      prefix "/usr"
    }
}


// environment exports
// accessed using Rust qualifiers such as env::target, etc
// typed as (var)
// this is to help define the custody chain for the hashing algorithm.

module env {
  variables {
    // (var)env::target
    target (var)phase::target
    prefix (var)phase::prefix
  }

  // exported into the shell environment
  exports {
    // exported as ENV_PREFIX
    PREFIX (var)prefix
    TARGET (var)target
  }
}

module autotools {
  // autotools::configure
  action configure {
    properties {
      (string) command "./configure"
      (string) prefix "/usr"
      (list) enable "shared"
      (list) disable "static"
      (list) with
      (list) without
      (string) target (var)env::target
    }

    // Begin writing a shell script
    execute {
      emit (prop)command "--prefix=" (prop)prefix
      with enable {
        emit " "
        foreach prop enable {
          emit "--enable-" (prop)prop
        }
      }
      with disable {
        emit " "
        foreach prop disable {
          emit "--disable-" (var)prop
        }
      }
      with target {
        emit " --target=" (var)env::target
      }
      emit_newline
    }
  }
}

